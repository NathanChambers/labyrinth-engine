capture.configure(1280, 720, "shadow-intersection-isolation", false);
capture.set_camera([0.0, 3.0, 5.0], [0.0, 0.8, 0.0]);
capture.set_shadow_quality(2);
capture.set_render_effects(false, false, false);
capture.wait(0.5);
capture.screenshot("no_shadows_no_gi");
capture.set_render_effects(true, false, false);
capture.wait(0.5);
capture.screenshot("shadows_only");
capture.set_render_effects(false, true, false);
capture.wait(0.5);
capture.screenshot("gi_only");
capture.set_render_effects(true, true, false);
capture.wait(0.5);
capture.screenshot("shadows_and_gi");
capture.exit();
