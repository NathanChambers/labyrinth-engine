capture.configure(1280, 720, "room-light-bleed", false);
capture.set_render_effects(true, true, false);
capture.set_ambient_occlusion(false);
capture.set_shadow_quality(2);
capture.wait(1.5);
capture.set_camera([0.0, 4.0, 13.0], [0.0, 1.0, 0.0]);
capture.screenshot("overview");
capture.wait(0.5);
capture.set_camera([0.0, 1.5, 8.5], [0.0, 1.5, 0.0]);
capture.screenshot("central_boxes");
capture.wait(0.5);
capture.set_camera([-8.5, 1.5, 8.5], [-8.5, 1.5, 0.0]);
capture.screenshot("left_room");
capture.wait(0.5);
capture.set_camera([8.5, 1.5, 8.5], [8.5, 1.5, 0.0]);
capture.screenshot("right_room");
capture.wait(0.5);
capture.set_camera([0.0, 1.5, -8.5], [0.0, 1.5, -11.0]);
capture.screenshot("rear_wall");
capture.set_ambient_occlusion(true);
capture.wait(0.5);
capture.set_camera([0.0, 1.5, 8.5], [0.0, 1.5, 0.0]);
capture.screenshot("central_boxes_ao");
capture.report("performance");
capture.exit();
