capture.configure(1280, 720, "gi-test-diagnostic", false);
capture.wait(2.0);
capture.report("performance");
capture.set_camera([0.0, 2.4, 7.0], [0.0, 1.2, -2.0]);
capture.screenshot("overview");
capture.wait(0.5);
capture.set_camera([-2.8, 1.8, 2.0], [-1.5, 1.2, -4.5]);
capture.screenshot("red_cube");
capture.wait(0.5);
capture.set_camera([2.8, 1.8, 2.0], [1.5, 1.2, -4.5]);
capture.screenshot("green_sphere");
capture.wait(0.5);
capture.set_camera([0.0, 0.8, 4.5], [0.0, 0.05, -1.0]);
capture.screenshot("floor_bounce");
capture.wait(0.5);
capture.set_camera([-4.2, 2.0, -1.0], [-2.5, 1.0, -4.5]);
capture.screenshot("left_corner");
capture.wait(0.5);
capture.set_camera([4.2, 2.0, -1.0], [2.5, 1.0, -4.5]);
capture.screenshot("right_corner");
capture.exit();
