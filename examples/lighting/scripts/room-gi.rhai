capture.configure(1280, 720, "room-gi", false);
capture.set_render_effects(true, true, false);
capture.set_ambient_occlusion(false);
capture.set_render_mode("lit");
capture.wait(1.5);
capture.set_camera([0.0, 15.0, 0.0], [0.0, 0.0, 0.0]);
capture.screenshot("overhead_gi");
capture.wait(0.5);
capture.set_camera([8.0, 12.0, 8.0], [0.0, 0.0, 0.0]);
capture.screenshot("diagonal_gi");
capture.exit();
