capture.configure(1280, 720, "genos-triangle-occlusion-profile", false);
capture.set_camera([12.5, 1.7, 31.0], [12.5, 1.6, 12.0]);
capture.set_render_effects(true, true, false);
capture.set_triangle_probe_occlusion(true);
capture.set_triangle_probe_diagnostics(true);
capture.wait(2.0);
capture.report("triangle_bvh_diagnostics");
capture.set_triangle_probe_diagnostics(false);
capture.set_triangle_probe_occlusion(false);
capture.wait(0.5);
capture.set_triangle_probe_diagnostics(true);
capture.wait(1.0);
capture.report("triangle_bvh_disabled_diagnostics");
capture.set_triangle_probe_diagnostics(false);
capture.set_triangle_probe_occlusion(true);
capture.wait(2.0);
capture.report("triangle_on_01");
capture.wait(0.25);
capture.report("triangle_on_02");
capture.wait(0.25);
capture.report("triangle_on_03");
capture.wait(0.25);
capture.report("triangle_on_04");
capture.wait(0.25);
capture.report("triangle_on_05");
capture.set_triangle_probe_occlusion(false);
capture.wait(1.0);
capture.report("triangle_off_01");
capture.wait(0.25);
capture.report("triangle_off_02");
capture.wait(0.25);
capture.report("triangle_off_03");
capture.wait(0.25);
capture.report("triangle_off_04");
capture.wait(0.25);
capture.report("triangle_off_05");
capture.exit();
