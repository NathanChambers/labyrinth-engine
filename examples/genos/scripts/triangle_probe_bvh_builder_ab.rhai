capture.configure(1280, 720, "genos-triangle-bvh-builder-ab", false);
capture.set_camera([12.5, 1.7, 31.0], [12.5, 1.6, 16.0]);
capture.set_render_effects(true, true, false);
capture.set_triangle_probe_occlusion(true);
capture.set_triangle_probe_diagnostics(false);
capture.set_triangle_probe_bvh_sah(false);
capture.wait(3.0);
capture.report("median_01");
capture.wait(0.25);
capture.report("median_02");
capture.wait(0.25);
capture.report("median_03");
capture.wait(0.25);
capture.report("median_04");
capture.wait(0.25);
capture.report("median_05");
capture.set_triangle_probe_bvh_sah(true);
capture.wait(3.0);
capture.report("sah_01");
capture.wait(0.25);
capture.report("sah_02");
capture.wait(0.25);
capture.report("sah_03");
capture.wait(0.25);
capture.report("sah_04");
capture.wait(0.25);
capture.report("sah_05");
capture.set_triangle_probe_bvh_sah(false);
capture.wait(3.0);
capture.report("median_repeat_01");
capture.wait(0.25);
capture.report("median_repeat_02");
capture.wait(0.25);
capture.report("median_repeat_03");
capture.wait(0.25);
capture.report("median_repeat_04");
capture.wait(0.25);
capture.report("median_repeat_05");
capture.exit();
